<resources>
    <style name="Theme.Kinopub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kino_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Launch theme: system splash (mark on the app background) until Home has data. -->
    <style name="Theme.Kinopub.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0E0F12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Kinopub</item>
    </style>
</resources>
